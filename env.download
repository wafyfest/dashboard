# Local development default configuration
# If Supabase URL and key are provided, it connects to Supabase.
# Otherwise, it falls back seamlessly to the comprehensive in-memory / local storage demo database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_NAME="Inter-College Arts Fest Management System"
NEXT_PUBLIC_DEMO_MODE=true
